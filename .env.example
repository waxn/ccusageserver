# Copy to .env and fill in. Only LEDGER_SECRET_KEY is strictly required.

# REQUIRED. Signs dashboard session JWTs. Generate with:
#   openssl rand -hex 32
LEDGER_SECRET_KEY=

# Public URL the agents (and your browser) reach this server at. Used to render
# the install one-liner and enrollment install command.
# IMPORTANT: include the scheme (https://). A scheme-less value makes the agent
# talk http:// and get redirected, breaking enrollment.
#   e.g. https://ledger.example.com
LEDGER_PUBLIC_BASE_URL=

# Host port to publish the container on (container listens on 8000 internally).
LEDGER_PORT=8787

# Pinned ccusage version every enrolled machine will run (keeps reports comparable).
LEDGER_CCUSAGE_VERSION=20.0.20

# Flag a device "stale" on the dashboard after this many hours without a check-in.
LEDGER_DEVICE_STALE_AFTER_HOURS=24

# --- Notes ------------------------------------------------------------------
# Usage data is end-to-end encrypted. The encryption password is chosen per
# account in the dashboard (and set on each agent) — it is NOT configured here,
# and the server never receives it.
#
# Optional advanced settings (sensible defaults; uncomment to override):
#   LEDGER_ENROLLMENT_TOKEN_EXPIRE_HOURS=168   # enrollment token lifetime (0 = never)
#   LEDGER_ACCESS_TOKEN_EXPIRE_MINUTES=10080   # dashboard session length
#   LEDGER_DATABASE_URL=sqlite:////data/ledger.db
#   LEDGER_ARCHIVE_DIR=/data/archives          # only used if a device opts into raw archives
